{
  "name": "@cinatra-ai/blog-linkedin-writer-agent",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Stateless leaf agent that writes a short promotional LinkedIn post for a published company blog post. Takes companyUrl, postTitle, postExcerpt, blogPostContent, blogPostUrl, destinationType, destinationName and returns { post, title, notes }. No HITL. Single bridge invocation; no toolbox is declared, so platform default-toolbox injection applies.",
  "type": "module",
  "files": [
    "cinatra"
  ],
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Blog LinkedIn Writer Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/linkedin-artifacts",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      },
      {
        "packageName": "@cinatra-ai/blog-post-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "consumes": [],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "blog-linkedin-writer-agent-flow",
    "sourceVersionId": "a98a0f35-55a7-4020-b5f0-a1cebd253d47",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": false,
    "toolAccess": [],
    "ownerOrgId": null,
    "produces": [
      {
        "extension": "@cinatra-ai/linkedin-artifacts",
        "objectTypeId": "@cinatra-ai/linkedin:post-draft"
      }
    ]
  },
  "scripts": {
    "test": "sh -c \"node --test\""
  }
}
